-- =========================================================================
-- SuperX kernel schema v2 — SOURCE OF TRUTH for the kernel layer
-- =========================================================================
--
-- Designed operator + model 2026-08-06 (G1); documented in
-- SUPERX_SCHEMA.md. Applied ONCE under the operator's root account on a
-- fresh database via scripts/deploy-schema.sh. From the moment this
-- file is applied, the kernel schema is LOCKED: any change to a DEFINE
-- statement here requires an explicit, prior, per-change
-- `Operator-approved: …` marker in the PR body that touches this file
-- (skill §7, CI-enforced).
--
-- Contracts (see SUPERX_SCHEMA.md §1):
--   • Append-only: the kernel's service account behavior contract is
--     SELECT + CREATE, enforced by kernel-verb discipline. The
--     PERMISSIONS `FOR update / FOR delete NONE` clauses below are
--     documentation of intent — SurrealDB's EDITOR role does not honour
--     them for system users.
--   • SCD-2 by ordering: "current" = ORDER BY valid_from DESC LIMIT 1
--     within a chain. No is_current / valid_to columns, ever.
--   • Row ids are UUIDv7, generated by the kernel at insert time.
--   • Single global OS: one operator, no tenancy, telemetry global.
--
-- Substitution: `$SUPERX_KERNEL_PASSWORD` is replaced by envsubst in
-- scripts/deploy-schema.sh at apply time; the repo never holds a real
-- password literal.
-- =========================================================================


-- -------------------------------------------------------------------------
-- Kernel service account — the kernel's only credential after deploy.
-- Session never expires (operator decision 2026-08-06; v1's 1 h session
-- killed long-running OS processes). Token keeps SurrealDB's 1 h default.
-- -------------------------------------------------------------------------
DEFINE USER IF NOT EXISTS superx_kernel ON DATABASE
    PASSWORD '$SUPERX_KERNEL_PASSWORD'
    ROLES EDITOR
    DURATION FOR TOKEN 1h, FOR SESSION NONE;


-- =========================================================================
-- type_definition — the metamodel
-- =========================================================================
-- Types are data: new entity / edge / attribute types arrive by INSERT,
-- never DDL. Immutable once created (UNIQUE uid); evolution = new uid
-- or an operator-approved migration.
DEFINE TABLE type_definition SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD uid         ON TABLE type_definition TYPE string;
DEFINE FIELD category    ON TABLE type_definition TYPE string
    ASSERT $value INSIDE ['node', 'edge', 'attribute'];
DEFINE FIELD is_acyclic  ON TABLE type_definition TYPE bool;
DEFINE FIELD sch_json    ON TABLE type_definition TYPE option<string>;
DEFINE FIELD memory_tier ON TABLE type_definition TYPE string
    ASSERT $value INSIDE ['core', 'working', 'archival', 'recall'];
DEFINE FIELD valid_from  ON TABLE type_definition TYPE datetime;

DEFINE INDEX idx_type_definition_uid ON TABLE type_definition
    FIELDS uid UNIQUE;


-- =========================================================================
-- cursor_type — the cursor-kind metamodel
-- =========================================================================
-- `workload` for run-progress cursors, `telemetry` for capture-source
-- cursors. Same immutability contract as type_definition.
DEFINE TABLE cursor_type SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD uid         ON TABLE cursor_type TYPE string;
DEFINE FIELD category    ON TABLE cursor_type TYPE string
    ASSERT $value INSIDE ['workload', 'telemetry'];
DEFINE FIELD description ON TABLE cursor_type TYPE string;
DEFINE FIELD sch_json    ON TABLE cursor_type TYPE option<string>;
DEFINE FIELD valid_from  ON TABLE cursor_type TYPE datetime;

DEFINE INDEX idx_cursor_type_uid ON TABLE cursor_type
    FIELDS uid UNIQUE;


-- =========================================================================
-- entity — identity (the persistent "who")
-- =========================================================================
-- Agents, sources, modules, adapters, products, … — everything the OS
-- knows exists. Differentiated by `type`.
DEFINE TABLE entity SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD type        ON TABLE entity TYPE record<type_definition>
    ASSERT $value.category = 'node';
DEFINE FIELD valid_from  ON TABLE entity TYPE datetime;


-- =========================================================================
-- relation — unified graph edges (in → out, typed)
-- =========================================================================
DEFINE TABLE relation SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD in          ON TABLE relation TYPE record<entity>;
DEFINE FIELD out         ON TABLE relation TYPE record<entity>;
DEFINE FIELD type        ON TABLE relation TYPE record<type_definition>
    ASSERT $value.category = 'edge';
DEFINE FIELD is_acyclic  ON TABLE relation TYPE bool;
DEFINE FIELD valid_from  ON TABLE relation TYPE datetime;


-- =========================================================================
-- state_ledger — SCD-2 content (the versioned "what")
-- =========================================================================
-- Typed attribute writes; new rows supersede older ones per
-- (target, type) chain. `payload` is FLEXIBLE because SCHEMAFULL would
-- otherwise require every nested key to be DEFINE FIELD'd, defeating
-- the opaque-payload contract; per-attribute shape is enforced by
-- kernel-verb discipline at the boundary.
DEFINE TABLE state_ledger SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD target      ON TABLE state_ledger TYPE record<entity>;
DEFINE FIELD type        ON TABLE state_ledger TYPE record<type_definition>
    ASSERT $value.category = 'attribute';
DEFINE FIELD payload     ON TABLE state_ledger TYPE object FLEXIBLE;
DEFINE FIELD valid_from  ON TABLE state_ledger TYPE datetime;

DEFINE INDEX idx_state_ledger_chain ON TABLE state_ledger
    FIELDS target, type, valid_from;


-- =========================================================================
-- cursor — durable capture / workload checkpoints
-- =========================================================================
-- Append-only; the capture engine resumes losslessly from the latest
-- row per (subject, cursor_type).
DEFINE TABLE cursor SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD subject        ON TABLE cursor TYPE record<entity>;
DEFINE FIELD cursor_type    ON TABLE cursor TYPE record<cursor_type>;
DEFINE FIELD last_processed ON TABLE cursor TYPE option<string>;
DEFINE FIELD metadata       ON TABLE cursor TYPE option<object> FLEXIBLE;
DEFINE FIELD valid_from     ON TABLE cursor TYPE datetime;

DEFINE INDEX idx_cursor_chain ON TABLE cursor
    FIELDS subject, cursor_type, valid_from;


-- =========================================================================
-- telemetry_stream — the firehose
-- =========================================================================
-- One row per event: every kernel mutation, every capture emission,
-- every lifecycle transition. `subject` is whoever emitted the event —
-- a module, agent, or source entity; deliberately un-ASSERTed.
-- Event rows are never superseded; valid_from is the event timestamp.
DEFINE TABLE telemetry_stream SCHEMAFULL
    PERMISSIONS
        FOR select FULL
        FOR create FULL
        FOR update NONE
        FOR delete NONE;

DEFINE FIELD lifecycle_event ON TABLE telemetry_stream TYPE string;
DEFINE FIELD payload         ON TABLE telemetry_stream TYPE any;
DEFINE FIELD subject         ON TABLE telemetry_stream TYPE option<record<entity>>;
DEFINE FIELD valid_from      ON TABLE telemetry_stream TYPE datetime;

DEFINE INDEX idx_telemetry_valid_from ON TABLE telemetry_stream
    FIELDS valid_from;


-- =========================================================================
-- END — schema locked from here forward (skill §7)
-- =========================================================================
